#! /usr/bin/env bash
#
###################################################################
# Postwhite - Automatic Postcreen allowlist / denylist Generator #
# https://github.com/stevejenkins/postwhite                       #
# By Steve Jenkins (https://www.stevejenkins.com/)                #
###################################################################

version="3.4"
lastupdated="4 May 2022"

# Usage: 1) Place entire /postwhite directory in /usr/local/bin
#	 2) Move postwhite.conf to /etc
#	 3) Run ./postwhite [config-file]
# Optional config file passed via command line overrides the default config file location.
#
# Requires SPF-Tools (https://github.com/jsarenik/spf-tools)
# Please update your copy of spf-tools whenever you update Postwhite
#
# Thanks to Mike Miller (mmiller@mgm51.com) for gallowlist.sh script.
# Thanks to Jan Sarenik for SPF-Tools.
# Thanks to Jose Borges Ferreira for IPv4 normalization help.
# Thanks to Ricardo Iván Vieitez Parra for improved error reporting, normalization, conf file
#           improvements, and removal of bash-isms so that script is usable on more systems.
# Thanks to Steve Cook for Yahoo! IP scraping help.
# Thanks to all the additional contributors on GitHub!
#
# USER-DEFINABLE OPTIONS AND CUSTOM HOSTS STORED IN /etc/postwhite.conf
# CONFIGURATION FILE CAN ALSO BE PASSED FROM COMMAND LINE
#
# NO NEED TO EDIT PAST THIS LINE
#
#################################################################

# DEFAULT HOSTS
# CUSTOM HOSTS CAN BE ADDED IN /etc/postwhite.conf

# Hosts to query
webmail_hosts="aol.com fastmail.com google.com gmx.com hotmail.com icloud.com \
	inbox.com mail.com microsoft.com migadu.com outlook.com \
	secure-mailgate.com tutanota.com zoho.com _spf.protonmail.ch \
	_spf1.yahoo.com _spf2.yahoo.com _spf3.yahoo.com"

social_hosts="facebook.com facebookmail.com instagram.com linkedin.com \
	pinterest.com reddit.com tiktok.com tumblr.com twitter.com x.com"

commerce_hosts="amazon.com craigslist.org ebay.com paypal.com"

bulk_hosts="amazonses.com authsmtp.com constantcontact.com \
	cust-spf.exacttarget.com exacttarget.com fbmta.com fishbowl.com \
	icontact.com mailchimp.com mailgun.com mailjet.com messagelabs.com \
	messagegears.net mtasv.net sendgrid.com sendgrid.net sparkpost.com \
	sparkpostmail.com spf.brevo.com"

misc_hosts="codeberg.org github.com gitlab.com sr.ht zendesk.com"

permit_line_v4="%s\tpermit\n"
reject_line_v4="%s\treject\n"

permit_line_v6="${permit_line_v4}"
reject_line_v6="${reject_line_v4}"

# Abort script on error (FYI: enabling will cause script to exit silently if mailer has no valid results)
set -e

# Postfix must be able to read the tables; temp files stay private (mktemp)
umask 022

fatal() {
	>&2 printf "fatal: %s\n" "$*"
	exit 1
}

# summarize with the first tool found in the system path:
#   aggregate-cidr     https://github.com/nabbi/route-summarization-rs
#   aggregateCIDR.pl   https://github.com/nabbi/route-summarization
if ! aggregateCIDR=$(command -v aggregate-cidr || command -v aggregateCIDR.pl) ; then
    echo "fatal: unable to locate aggregate-cidr or aggregateCIDR.pl"
    echo "https://github.com/nabbi/route-summarization-rs"
    exit 1
fi

if ! postmap=$(which postmap) ; then
	echo "fatal: unable to locate postmap"
	exit 1
fi

printf "Starting Postwhite v$version ($lastupdated)\n"

# Check for passed config file
config_file="/etc/postwhite.conf"
if [ -n "$1" ]; then
	config_file="$1"
fi

# Read config file options
if [ ! -s "$config_file" ] ; then
	printf "%s: Can't find %s. Exiting.\n" "$0" "$config_file" 1>&2
	exit 1
fi
if [ -n "$(find -L "$config_file" -prune -perm -0002 2>/dev/null)" ]; then
	fatal "$config_file is world-writable"
fi
printf "\nReading options from %s...\n" "$config_file"

# Read key=value settings rather than sourcing the file, so the config can't
# run commands or replace the script's own variables. Settings start empty so
# none leak in from the environment.
config_keys="spftoolspath postfixpath postfixbinarypath allowlist denylist \
	yahoo_static_hosts custom_hosts include_yahoo enable_denylist \
	denylist_hosts reload_postfix"
for k in $config_keys; do
	eval "$k="
done
while IFS= read -r line || [ -n "$line" ]; do
	# trim surrounding whitespace
	line="${line#"${line%%[![:space:]]*}"}"
	line="${line%"${line##*[![:space:]]}"}"
	case $line in
		''|'#'*) continue ;;
		*=*) ;;
		*) fatal "$config_file: not a setting: $line" ;;
	esac
	key="${line%%=*}"
	value="${line#*=}"
	# drop one pair of surrounding quotes
	case $value in
		\"*\") value="${value#\"}"; value="${value%\"}" ;;
		\'*\') value="${value#\'}"; value="${value%\'}" ;;
	esac
	known=
	for k in $config_keys; do
		if [ "$key" = "$k" ]; then
			known=yes
			eval "$k=\$value"
		fi
	done
	if [ -z "$known" ]; then
		>&2 printf "%s: ignoring unknown setting %s\n" "$config_file" "$key"
	fi
done < "$config_file"

# tables are written into postfixpath, so their names must not leave it
for t in allowlist denylist; do
	eval "v=\$$t"
	case $v in
		''|.|..|*/*) fatal "$t must be a file name, not '$v'" ;;
	esac
done
if [ ! -d "$postfixpath" ]; then
	fatal "postfixpath $postfixpath is not a directory"
fi
if [ ! -x "${spftoolspath}/despf.sh" ]; then
	fatal "can't run ${spftoolspath}/despf.sh"
fi

# Create temporary files
printf "\nCreating temporary files...\n"
tmpBase=$(basename "$0")

tmpPrefix="tmp"
if [ x"$enable_denylist" = x"yes" ]; then
	tmpPrefix="tmp denytmp"
fi

# Remove temp files, however the script exits
cleanup() {
	for p in $tmpPrefix; do
		for i in 1 2 3 4 5; do
			eval "t=\${${p}${i}:-}"
			if [ -n "$t" ]; then
				rm -f "$t"
			fi
		done
	done
	if [ -n "${newtable:-}" ]; then
		rm -f "$newtable"
	fi
}
trap cleanup EXIT

for p in $tmpPrefix; do
	for i in 1 2 3 4 5; do
		t="$(mktemp -q "${TMPDIR:-/tmp}"/"${tmpBase}".XXXXXX)"
		if [ $? -ne 0 ]; then
			>&2 printf "%s: Can't create temp files, exiting...\n" "$0"
			exit 1
		fi
		eval "${p}${i}=\$t"
	done
done

# Create IPv4 normalize function
ip2int() {
	for i in 1 2 3 4 5; do
		eval ip2int_${i}="$(echo "$1" | cut -s -d. -f$i)"
	done
	ip2int_valid_range="$((ip2int_1 | ip2int_2 | ip2int_3 | ip2int_4))"
	[ -z "$ip2int_5" ] && [ -n "$ip2int_1" ] && [ -n "$ip2int_2" ] && [ -n "$ip2int_3" ] && [ -n "$ip2int_4" ] && [ "$ip2int_valid_range" -ge 0 ] && [ "$ip2int_valid_range" -le 255 ] &&
		printf "%d" "$(((((((ip2int_1 << 8) | ip2int_2) << 8) | ip2int_3) << 8) | ip2int_4))"
}

int2ip() {
	int2ip_ui32="$1"; shift
	int2ip_ip=""
	[ -n "$int2ip_ui32" ] && [ "$int2ip_ui32" -ge 0 ] && [ "$int2ip_ui32" -le 4294967295 ] && for n in 1 2 3 4; do
		int2ip_ip="$((int2ip_ui32 & 0xff))${int2ip_ip:+.}$int2ip_ip"
		int2ip_ui32="$((int2ip_ui32 >> 8))"
	done
	printf "%s" "${int2ip_ip}"
}

network_v4() {
	network_v4_ia="$(echo "$1" | cut -d/ -f1)"
	network_v4_netmask="$(echo "$1" | cut -d/ -f2-)"
	if [ -n "$network_v4_netmask" ] && [ "$network_v4_netmask" -ge 0 ] && [ "$network_v4_netmask" -le 32 ]; then
		network_v4_addr="$(ip2int $network_v4_ia)"
		network_v4_mask="$((0xffffffff << (32 - network_v4_netmask)))"
		if [ "$network_v4_netmask" -eq 32 ]; then
			printf "%s" $(int2ip $((network_v4_addr & network_v4_mask)))
		else
			printf "%s/%s" "$(int2ip $((network_v4_addr & network_v4_mask)))" "$network_v4_netmask"
		fi
	fi
}

network_v6() {
	printf "%s" "$1"
}

normalize_ip() {
	# split by ":"
	normalize_ip_type="$( echo $1 | cut -s -d\: -f1)"
	normalize_ip_value="$( echo $1 | cut -s -d\: -f2-)"
	normalize_ip_IP=""
	if [ x"${normalize_ip_type}" = x"ip4" ] ; then
		# check if is a CIDR
		if expr "x${normalize_ip_value}" : "x.*/[0-9]*" > /dev/null; then
			normalize_ip_IP="$(network_v4 "${normalize_ip_value}")"
		else
			normalize_ip_IP="$(network_v4 "${normalize_ip_value}/32")"
		fi
	elif [ x"${normalize_ip_type}" = x"ip6" ]; then
		normalize_ip_IP="$(network_v6 "${normalize_ip_value}")"
	fi
	printf "%s" "$normalize_ip_IP"
}

# Skip host names despf.sh could take for an option or that aren't names
valid_host() {
	case $1 in
		''|-*|*[!A-Za-z0-9._-]*)
			>&2 printf "Skipping invalid host name: %s\n" "$1"
			return 1 ;;
	esac
}

# Create host query function
query_host() {
	valid_host "$1" || return 0
	"${spftoolspath}"/despf.sh "$1" | (grep -Ei ^ip || true ) >> "${tmp1}"
}

query_deny_host() {
	valid_host "$1" || return 0
	"${spftoolspath}"/despf.sh "$1" | (grep -Ei ^ip || true ) >> "${denytmp1}"
}

# Create progress dots function
show_dots() {
	while kill -0 "$1" 2>/dev/null; do
		printf "."
		sleep 1
	done
	printf "\n"
}

# Fix mode
fix_invalid_ip() {
	fix_invalid_ip_iptype="$( echo "$1" | cut -d\: -f1 )"
	fix_invalid_ip_ip="$(normalize_ip "$1")"
	if [ -n "$fix_invalid_ip_ip" ]; then
		if [ x"$fix_invalid_ip_iptype" = x"ip4" ]; then
			printf "$(eval printf "%s" "\${${2}_line_v4}")" "$fix_invalid_ip_ip"
		elif [ x"$fix_invalid_ip_iptype" = x"ip6" ] ; then
			printf "$(eval printf "%s" "\${${2}_line_v6}")" "$fix_invalid_ip_ip"
		fi
	fi
}

# Remove mode
remove_invalid_ip() {
	remove_invalid_ip_iptype="$( echo "$1" | cut -d\: -f1 )"
	remove_invalid_ip_origip="$( echo "$1" | cut -d\: -f2- )"
	remove_invalid_ip_ip="$(normalize_ip "$1")"
	if [ x"$remove_invalid_ip_origip" = x"$remove_invalid_ip_ip" ]; then
		if [ x"$remove_invalid_ip_iptype" = x"ip4" ]; then
			printf "$(eval printf "%s" "\${${2}_line_v4}")" "$remove_invalid_ip_ip"
		elif [ x"$remove_invalid_ip_iptype" = x"ip6" ] ; then
			printf "$(eval printf "%s" "\${${2}_line_v6}")" "$remove_invalid_ip_ip"
		fi
	fi
}

# Keep mode
keep_invalid_ip() {
	keep_invalid_ip_iptype="$( echo "$1" | cut -d\: -f1 )"
	keep_invalid_ip_ip="$( echo "$1" | cut -d\: -f2- )"
	# entries come from DNS: never let one add fields or lines to the table
	case $keep_invalid_ip_ip in
		''|*[!0-9A-Fa-f.:/]*) return 0 ;;
	esac
	if [ -n "$keep_invalid_ip_ip" ]; then
		if [ x"$keep_invalid_ip_iptype" = x"ip4" ]; then
			printf "$(eval printf "%s" "\${${2}_line_v4}")" "$keep_invalid_ip_ip"
		elif [ x"$keep_invalid_ip_iptype" = x"ip6" ] ; then
			printf "$(eval printf "%s" "\${${2}_line_v6}")" "$keep_invalid_ip_ip"
		fi
	fi
}

# Let's DO this!

printf "\nRecursively querying SPF records of selected allowlist mailers...\n"

# Query selected mailers

printf "\nQuerying webmail hosts...\n"

for h in ${webmail_hosts}; do
	query_host "${h}"
done

printf "\nQuerying social network hosts...\n"

for h in ${social_hosts}; do
	query_host "${h}"
done

printf "\nQuerying ecommerce hosts...\n"

for h in ${commerce_hosts}; do
	query_host "${h}"
done

printf "\nQuerying bulk mail hosts...\n"

for h in ${bulk_hosts}; do
	query_host "${h}"
done

printf "\nQuerying miscellaneous hosts...\n"

for h in ${misc_hosts}; do
	query_host "${h}"
done

printf "\nQuerying custom hosts...\n"

for h in ${custom_hosts}; do
	query_host "${h}"
done

if [ x"$include_yahoo" = x"yes" ] ; then
	printf "\nIncluding scraped Yahoo! outbound hosts...\n"

	if [ ! -r "$yahoo_static_hosts" ]; then
		fatal "can't read $yahoo_static_hosts"
	fi
	(grep -Ei ^ip "${yahoo_static_hosts}" || true) >> "${tmp1}"
fi

if [ x"$enable_denylist" = x"yes" ] ; then
	printf "\nQuerying denylist hosts...\n"

	for h in ${denylist_hosts}; do
		query_deny_host "${h}"
	done
fi

printf "\nCIDR and Host summarization using %s...\n" "${aggregateCIDR}"
# invalid hosts are also screened and removed
sed '/\./s/\/32//g' "${tmp1}" | sort -u | ${aggregateCIDR} --quiet --spf > "${tmp2}" &
show_dots "$!"
# keep the current tables rather than replace them with empty ones
if ! wait "$!" ; then
	>&2 printf "fatal: %s failed\n" "${aggregateCIDR}"
	exit 1
fi

if [ x"$enable_denylist" = x"yes" ] ; then
        cat "${denytmp1}" | sort -u | ${aggregateCIDR} --quiet --spf > "${denytmp2}" &
        show_dots "$!"
        if ! wait "$!" ; then
                >&2 printf "fatal: %s failed\n" "${aggregateCIDR}"
                exit 1
        fi
fi

#Format the lists
printf "\nFormatting allowlist IPv4 CIDRs...\n"
cat "${tmp2}" | while read -r ip; do
keep_invalid_ip "$ip" "permit"
done >> "${tmp3}" &
show_dots "$!"

if [ x"$enable_denylist" = x"yes" ] ; then
	printf "\nFormatting denylist IPv4 CIDRs...\n"
	cat "${denytmp2}" | while read -r ip; do
		keep_invalid_ip "$ip" "reject"
	done >> "${denytmp3}" &
	show_dots "$!"
fi

# Sort, uniq, and count final rules
# Have to do sort and uniq separately, as 'sort -u -t. -k1,1n...' removes valid rules
printf "\nSorting allowlist rules...\n"
sort -t. -k1,1n -k2,2n -k3,3n -k4,4n "${tmp3}" > "${tmp4}"
uniq "${tmp4}" >> "${tmp5}"
numrules="$(cat "${tmp5}" | wc -l)"

if [ x"$enable_denylist" = x"yes" ] ; then
	printf "\nSorting denylist rules...\n"
	sort -t. -k1,1n -k2,2n -k3,3n -k4,4n "${denytmp3}" > "${denytmp4}"
	uniq "${denytmp4}" >> "${denytmp5}"
	numdenyrules="$(cat "${denytmp5}" | wc -l)"
fi

# write_table <kind> <name> <rules file> <count>: replace a table in
# postfixpath by renaming a complete copy over it, so Postfix never reads a
# partial table and a symlink planted at its name is replaced, not followed
write_table() {
	table="${postfixpath}/$2"
	printf "\nWriting %s %s rules to %s...\n" "$4" "$1" "$table"
	if [ -d "$table" ]; then
		fatal "$table is a directory"
	fi
	newtable="$(mktemp "${postfixpath}/.$2.XXXXXX")"
	printf "# %s generated by Postwhite v%s on %s\n# https://github.com/stevejenkins/postwhite/\n# %s total rules\n" \
		"$1" "$version" "$(date)" "$4" > "$newtable"
	cat "$3" >> "$newtable"
	chmod 644 "$newtable"
	mv -f "$newtable" "$table"
	newtable=
	${postmap} "$table"
}

# Write allowlist and denylist to Postfix directory
write_table allowlist "${allowlist}" "${tmp5}" "$numrules"

if [ x"$enable_denylist" = x"yes" ] ; then
	write_table denylist "${denylist}" "${denytmp5}" "$numdenyrules"
fi

# Reload Postfix to pick up changes in allowlist
if [ x"$reload_postfix" = x"yes" ]; then
	printf '\nReloading Postfix configuration to refresh rules...\n'
	if [ "$(id -u)" -eq 0 ]; then
		"${postfixbinarypath}"/postfix reload
	else
		# -n: fail rather than wait under cron for a password (see SUDO.md)
		sudo -n "${postfixbinarypath}"/postfix reload
	fi
fi

printf '\nDone!\n'

exit
